{
  "name": "@ev/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "EV — a personal, local-first desktop agent powered by Pi",
  "type": "module",
  "main": "./dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --dir ../server run build && pnpm run typecheck && electron-vite build && node --experimental-strip-types scripts/check-main-bundle.ts",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "pack": "pnpm --dir ../cli run build && pnpm run clean:release && pnpm run build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac dir",
    "dist": "pnpm --dir ../cli run build && pnpm run clean:release && pnpm run build && electron-builder --mac",
    "clean:release": "node --experimental-strip-types ../../scripts/clean-release-output.ts"
  },
  "dependencies": {
    "@ev/contracts": "workspace:*",
    "@ev/design-tokens": "workspace:*",
    "@ev/ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.4.20",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "5.0.0",
    "postcss": "8.5.25",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.enhancedvigilance.desktop",
    "productName": "EV",
    "directories": {
      "output": "release/${version}",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "../cli/dist/ev.js",
        "to": "cli/ev.js"
      },
      {
        "from": "../../skills/ev-browser",
        "to": "skills/ev-browser"
      },
      {
        "from": "dist-server",
        "to": "server"
      }
    ],
    "asarUnpack": [
      "node_modules/@silvia-odwyer/photon-node/**/*"
    ],
    "mac": {
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "forceCodeSigning": false
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "license": "Apache-2.0"
}
