{
  "ignore": ["**/__tests__/**", "**/*.test.*"],
  "exclude": ["types", "exports", "nsTypes", "nsExports", "files"],
  "ignoreDependencies": [
    "@types/chrome",
    "@types/ws",
    "@wxt-dev/module-react",
    "electron-builder-squirrel-windows",
    "postject",
    "tailwindcss",
    "tailwindcss-animate"
  ],
  "workspaces": {
    "apps/cli": {
      "entry": ["scripts/*.ts"]
    },
    "apps/desktop": {
      "entry": ["electron.vite.config.ts", "src/main/index.ts", "src/renderer/src/main.tsx", "scripts/*.ts"]
    },
    "apps/browser-extension": {
      "entry": ["wxt.config.ts", "entrypoints/**/*.{ts,tsx,js,jsx}", "src/**/*.{ts,tsx}"]
    }
  }
}
